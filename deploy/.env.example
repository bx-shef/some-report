# Скопировать в `.env` рядом с docker-compose.prod.yml и заполнить.

# Домен, на котором раздаётся отчёт. Должен совпадать с NUXT_PUBLIC_SITE_URL,
# с которым собран образ, — иначе страница установки построит адрес обработчика
# плейсмента на ЧУЖОЙ домен, и портал откроет пустоту.
DOMAIN=some-report.bx-shef.by

# Контакт для Let's Encrypt по этому домену. Можно оставить пустым.
LETSENCRYPT_EMAIL=
