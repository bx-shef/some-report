# Скопировать в `.env` рядом с docker-compose.prod.yml и заполнить.

# Домен, на котором раздаётся отчёт. Должен совпадать с NUXT_PUBLIC_SITE_URL,
# с которым собран образ, — иначе страница установки построит адрес обработчика
# плейсмента на ЧУЖОЙ домен, и портал откроет пустоту.
DOMAIN=some-report.bx-shef.by

# Контакт для Let's Encrypt по этому домену. Можно оставить пустым.
LETSENCRYPT_EMAIL=

# Кто может встраивать отчёт во фрейм и куда приложению разрешено ходить (CSP
# `frame-ancestors` и `connect-src`), через пробел.
#
# ⚠ ОБЛАЧНЫЕ порталы Битрикс24 покрыты значением по умолчанию, зашитым в образ, — эту строку
# можно не трогать вовсе. Она нужна КОРОБОЧНОМУ порталу: он живёт на своём домене и ни под один
# облачный wildcard не подходит.
#
# ⚠ Забыть про неё дорого: портал покажет на месте отчёта ПУСТУЮ ОБЛАСТЬ без единой ошибки в
# интерфейсе. Заголовок присылает наш сервер, нарушение фиксирует браузер, в логах nginx при этом
# ни строки.
#
# Указывая свой список, ОБЛАЧНЫЕ ЗОНЫ НУЖНО ПЕРЕЧИСЛИТЬ ЗАНОВО: переменная заменяет значение по
# умолчанию целиком, а не дополняет его. Пример для коробочного портала ООО «Анкрон»:
#
# B24_PORTAL_ORIGINS=https://*.bitrix24.ru https://*.bitrix24.by https://*.bitrix24.com https://*.bitrix24.eu https://*.bitrix24.tech https://bitrix.ankron.by
