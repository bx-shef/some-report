# Скопировать в `.env` рядом с docker-compose.prod.yml и заполнить.

# Домен, на котором раздаётся отчёт. Должен совпадать с NUXT_PUBLIC_SITE_URL,
# с которым собран образ, — иначе страница установки построит адрес обработчика
# плейсмента на ЧУЖОЙ домен, и портал откроет пустоту.
DOMAIN=some-report.bx-shef.by

# Контакт для Let's Encrypt по этому домену. Можно оставить пустым.
LETSENCRYPT_EMAIL=

# ⚠ Домены порталов, которым разрешено встраивать отчёт, ЗДЕСЬ НЕ НАСТРАИВАЮТСЯ. Это часть
# продукта: список живёт в Dockerfile и приезжает с образом. Облачные порталы покрыты
# wildcard'ами; коробочный портал клиента добавляется в тот список в репозитории и выкатывается
# как любая правка кода.

# --- Приостановка приложения при незавершённом приёме работ ---------------------------------------------
# Пусто = блокировки нет (так собран образ). Применяется перезапуском контейнера, без пересборки.
#
# С какого дня показывать экран напоминания: он висит 20 секунд и пускает дальше.
PAYMENT_LOCK_SOFT_FROM=
# С какого дня приложение уже не открывается совсем.
PAYMENT_LOCK_HARD_FROM=
# Рубильник «оплачено»: 1 снимает блокировку при любых датах. Быстрее, чем стирать даты.
PAYMENT_LOCK_OFF=
#
# ⚠ Кривое значение РОНЯЕТ контейнер при старте (deploy/validate-payment-lock.sh), и это
# намеренно: приложение на мусор отвечает «блокировки нет», то есть опечатка дала бы тихо
# неработающую блокировку. Формат — YYYY-MM-DD. Пустые значения законны.
# ⚠ Установщик `/install` не блокируется никогда: через него портал переустанавливает приложение.
